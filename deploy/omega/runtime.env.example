# runtime.env — Omega agent container environment (see start.sh --env-file)
# Copy to runtime.env and fill values; never commit the real file.

# ASI:One provider API key (provider=ASIOne on the container command line)
ASIONE_API_KEY=REPLACE_WITH_PROVIDER_API_KEY

# Telegram bot token (commchannel=telegram)
TG_BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN

# Import the KB on container start (validated value: 1)
IMPORT_KB_ON_START=1

# Host-side memory directory bound into the container (omega-curiosity-memory volume path)
MEMORY_DIR=/home/ubuntu/omega-curiosity/memory

# Omega/omegaclaw auth secrets (channel + API authentication)
OMEGA_AUTH_SECRET=REPLACE_WITH_LONG_RANDOM_VALUE
OMEGACLAW_AUTH_SECRET=REPLACE_WITH_LONG_RANDOM_VALUE

# DAS read lane (bounded read proxy; agent has no write capability)
OMEGA_DAS_ENABLED=1
OMEGA_DAS_PROXY_ORIGIN=http://read-proxy:8080
