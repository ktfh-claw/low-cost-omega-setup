# plugins.yaml overlay for the das-write plugin (iteration 11).
# Bind-mount this file over /PeTTa/repos/Omega/config/plugins.yaml
# (read-only) in the agent container to activate the plugin; the
# overlay exists so the stock file is never edited in place.
#
# Base stock content (verified live on the OVH image omegaclaw:das-f38217f):

# plugins.yaml lists all plugins to be loaded by the agent
# see /docs/reference-plugin-api.md for details

- name: irc
  loader: python
  location: "{REPO}/channels"

- name: telegram
  loader: python
  location: "{REPO}/channels"

- name: slack
  loader: python
  location: "{REPO}/channels"

- name: mattermost
  loader: python
  location: "{REPO}/channels"

- name: mockchannel
  loader: python
  location: "{REPO}/channels"

- name: wschat
  loader: python
  location: "{REPO}/channels"

- name: openaiapi
  loader: python
  location: "{REPO}/providers"

- name: asione
  loader: python
  location: "{REPO}/providers"

- name: openrouter
  loader: python
  location: "{REPO}/providers"

- name: openai
  loader: python
  location: "{REPO}/providers"

- name: mockprovider
  loader: python
  location: "{REPO}/providers"

- name: workflow
  loader: metta
  location: "{REPO}/plugins/workflow"

- name: openclaw
  loader: metta
  location: "{REPO}/plugins/openclaw"

# Appended: the das-write interception plugin (add-atom &persistent
# routes to the write-bridge facade for durable, verified DAS writes).

- name: das-write
  loader: metta
  location: "{REPO}/plugins/das-write"

# Appended: the das-read plugin (iteration 31, alignment lane) — rebinds the
# das-retrieve skill clause to the plugin-mounted v2 adapter so the DAS read
# path (like the write path) is a config-level artifact of this repo: both
# the clause and the implementation come from mounts, not the image.
# The src/das_skills.py :ro file overlay in start.sh is kept as a redundant
# fallback (same v2 bytes); the plugin wins clause routing when loaded.

- name: das-read
  loader: metta
  location: "{REPO}/plugins/das-read"

# Appended: the pin working-memory plugin (2026-10-23, windowless-room v3) —
# the stock pin skill is a no-op stub that discards the item; this plugin
# rebinds pin to the prompt-extension path so pinned items re-appear in
# every following prompt of the run (cross-cycle working memory).

- name: pin
  loader: metta
  location: "{REPO}/plugins/pin"

# Appended: the metta-grammar plugin (2026-10-25, windowless-room scenario A
# close-out) — the stock metta skill registration (skills.metta:153) documents
# neither the NAL/PLN strictly-2-argument operator contract nor the
# ephemeral-atomspace chaining rule; live scenario-A evidence showed ~321 calls
# almost all in never-matching 3+-argument forms. This plugin re-registers the
# skill listing with the full why/when/grammar description (remove-skill +
# add-skill, single-definition invariant); the stock handler clause is correct
# and untouched.

- name: metta-grammar
  loader: metta
  location: "{REPO}/plugins/metta-grammar"
