# plugins.yaml overlay for the das-write plugin (iteration 11).
# Bind-mount this file over /PeTTa/repos/Omega/config/plugins.yaml
# (read-only) in the agent container to activate the plugin; the
# overlay exists so the stock file is never edited in place.
#
# Base stock content (verified live on the OVH image omegaclaw:das-f38217f):

# plugins.yaml lists all plugins to be loaded by the agent
# see /docs/reference-plugin-api.md for details

- name: irc
  loader: python
  location: "{REPO}/channels"

- name: telegram
  loader: python
  location: "{REPO}/channels"

- name: slack
  loader: python
  location: "{REPO}/channels"

- name: mattermost
  loader: python
  location: "{REPO}/channels"

- name: mockchannel
  loader: python
  location: "{REPO}/channels"

- name: wschat
  loader: python
  location: "{REPO}/channels"

- name: openaiapi
  loader: python
  location: "{REPO}/providers"

- name: asione
  loader: python
  location: "{REPO}/providers"

- name: openrouter
  loader: python
  location: "{REPO}/providers"

- name: openai
  loader: python
  location: "{REPO}/providers"

- name: mockprovider
  loader: python
  location: "{REPO}/providers"

- name: workflow
  loader: metta
  location: "{REPO}/plugins/workflow"

- name: openclaw
  loader: metta
  location: "{REPO}/plugins/openclaw"

# Appended: the das-write interception plugin (add-atom &persistent
# routes to the write-bridge facade for durable, verified DAS writes).

- name: das-write
  loader: metta
  location: "{REPO}/plugins/das-write"
