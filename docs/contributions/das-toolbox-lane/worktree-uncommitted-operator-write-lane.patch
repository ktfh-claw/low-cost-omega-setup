diff --git a/deploy/omega-das-integration/scripts/preflight.sh b/deploy/omega-das-integration/scripts/preflight.sh
index b91af56..75f08ef 100755
--- a/deploy/omega-das-integration/scripts/preflight.sh
+++ b/deploy/omega-das-integration/scripts/preflight.sh
@@ -30,6 +30,33 @@ done
 : "${MONGODB_USERNAME:?MONGODB_USERNAME is required}"
 : "${MONGODB_PASSWORD:?MONGODB_PASSWORD is required}"
 [ "${#MONGODB_PASSWORD}" -ge 20 ] || { echo "MONGODB_PASSWORD must be at least 20 characters" >&2; exit 1; }
+: "${DAS_WRITE_TOKEN_FILE:?DAS_WRITE_TOKEN_FILE is required}"
+case "$DAS_WRITE_TOKEN_FILE" in
+  /*) ;;
+  *) echo "DAS_WRITE_TOKEN_FILE must be absolute" >&2; exit 1 ;;
+esac
+[ ! -L "$DAS_WRITE_TOKEN_FILE" ] || { echo "DAS_WRITE_TOKEN_FILE must not be a symlink" >&2; exit 1; }
+[ -f "$DAS_WRITE_TOKEN_FILE" ] || { echo "DAS_WRITE_TOKEN_FILE must be a regular file" >&2; exit 1; }
+token_mode=$(stat -c '%a' "$DAS_WRITE_TOKEN_FILE")
+case "$token_mode" in
+  400|600) ;;
+  *) echo "DAS_WRITE_TOKEN_FILE mode must be 0400 or 0600" >&2; exit 1 ;;
+esac
+python3 - "$DAS_WRITE_TOKEN_FILE" <<'PY'
+import pathlib
+import sys
+
+raw = pathlib.Path(sys.argv[1]).read_bytes()
+token = raw.rstrip(b"\r\n")
+if not 32 <= len(token) <= 256 or raw not in (token, token + b"\n", token + b"\r\n"):
+    raise SystemExit("DAS_WRITE_TOKEN_FILE must contain one 32..256-byte token")
+try:
+    text = token.decode("ascii")
+except UnicodeDecodeError:
+    raise SystemExit("DAS_WRITE_TOKEN_FILE token must be printable ASCII")
+if any(character.isspace() or not character.isprintable() for character in text):
+    raise SystemExit("DAS_WRITE_TOKEN_FILE token must be printable ASCII without whitespace")
+PY
 
 "$base_dir/scripts/render-config.sh" "$env_file"
 docker compose --env-file "$env_file" -f "$base_dir/compose.yaml" config --quiet
